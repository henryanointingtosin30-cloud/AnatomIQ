  "shortcuts": [
    {
      "name": "Take Exam",
      "short_name": "Exam",
      "description": "Start a new anatomy exam",
      "url": "/?action=exam",
      "icons": [
        {
          "src": "/icons/icon-shortcut-exam.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Results",
      "short_name": "Results",
      "description": "Check your exam results and history",
      "url": "/?action=results",
      "icons": [
        {
          "src": "/icons/icon-shortcut-results.png",
